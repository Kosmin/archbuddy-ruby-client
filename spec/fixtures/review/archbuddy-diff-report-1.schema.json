{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "archbuddy-diff-report/1",
  "type": "object",
  "required": ["schema", "tool", "run", "summary", "findings", "grandfathered", "calibration", "exit_code"],
  "additionalProperties": false,
  "properties": {
    "schema": { "enum": ["archbuddy-diff-report/1"] },
    "tool": { "type": "object" },
    "run": {
      "type": "object",
      "required": ["command", "target", "advisory", "fail_level"],
      "properties": {
        "command": { "enum": ["diff", "lint"] },
        "target": { "type": ["string", "null"] },
        "config": { "type": ["string", "null"] },
        "advisory": { "type": "boolean" },
        "fail_level": { "enum": ["none", "info", "warn", "error"] },
        "base": { "type": "object" },
        "head": { "type": "object" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["counts", "not_evaluable", "excluded_files"],
      "additionalProperties": false,
      "properties": {
        "counts": {
          "type": "object",
          "required": ["error", "warn", "info", "grandfathered"],
          "properties": {
            "error": { "type": "integer" },
            "warn": { "type": "integer" },
            "info": { "type": "integer" },
            "grandfathered": { "type": "integer" }
          }
        },
        "delta": {
          "type": "object",
          "required": ["nodes_new", "nodes_grown", "nodes_shrunk", "nodes_removed", "net_log2_b_own"],
          "properties": {
            "nodes_new": { "type": "integer" },
            "nodes_grown": { "type": "integer" },
            "nodes_shrunk": { "type": "integer" },
            "nodes_removed": { "type": "integer" },
            "net_log2_b_own": { "type": "number" }
          }
        },
        "unreachable_from_entrypoints": {
          "type": "object",
          "required": ["nodes", "share", "files"],
          "properties": {
            "nodes": { "type": "integer" },
            "share": { "type": "number" },
            "files": { "type": "integer" }
          }
        },
        "disclosures": {
          "type": "object",
          "required": ["orphan_touched_files", "offsetting_zero_count"],
          "properties": {
            "orphan_touched_files": { "type": "array", "items": { "type": "string" } },
            "offsetting_zero_count": { "type": "integer" }
          }
        },
        "not_evaluable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "reason"],
            "properties": { "rule": { "type": "string" }, "reason": { "type": "string" } }
          }
        },
        "excluded_files": { "type": "array", "items": { "type": "string" } }
      }
    },
    "use_cases": {
      "type": "object",
      "required": ["count", "leaderboard"],
      "properties": {
        "count": { "type": "integer" },
        "leaderboard": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rank", "ep", "kind", "file", "branching_log2", "mass", "reach", "files", "depth", "dividend", "max_cone_node_log2", "cost_note"]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "severity", "line", "message", "grandfathered", "fingerprint"],
        "properties": {
          "rule": { "type": "string" },
          "severity": { "enum": ["error", "warn", "info"] },
          "file": { "type": ["string", "null"] },
          "symbol": { "type": ["string", "null"] },
          "line": { "type": "null" },
          "values": { "type": ["object", "null"] },
          "value_raw": { "type": ["integer", "null"] },
          "value_log2": { "type": ["number", "null"] },
          "delta_log2": { "type": ["number", "null"] },
          "threshold_raw": { "type": ["number", "null"] },
          "threshold_log2": { "type": ["number", "null"] },
          "message": { "type": "string" },
          "grandfathered": { "type": "boolean" },
          "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "components": { "type": "object" },
          "contributors": { "type": "array" },
          "contributors_omitted": { "type": "integer" },
          "entrypoint_kind": { "type": "string" },
          "scope": { "enum": ["pr"] }
        }
      }
    },
    "delta_top": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "symbol", "classification", "base_branches", "head_branches", "delta_log2"],
        "properties": { "classification": { "enum": ["NEW", "GROWN", "SHRUNK", "REMOVED", "CHANGED_ATTRS"] } }
      }
    },
    "ratchet": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "kind", "budget_log2", "verdict", "severity"],
        "properties": {
          "kind": { "enum": ["paths", "entrypoint"] },
          "verdict": { "enum": ["pass", "breach", "no_match"] },
          "observed_log2": { "type": ["number", "null"] },
          "empty_scope": { "type": "boolean" }
        }
      }
    },
    "review_surface": {
      "type": "object",
      "required": ["union", "sum", "eps", "unreachable_touched"],
      "properties": {
        "union": { "type": "integer" },
        "sum": { "type": "integer" },
        "eps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "ep_symbol", "branching_log2", "classification"],
            "properties": { "classification": { "enum": ["NEW", "REMOVED", "MATCHED"] } }
          }
        },
        "unreachable_touched": {
          "type": "object",
          "required": ["count", "nodes"]
        }
      }
    },
    "signals": {
      "description": "OPTIONAL, lint-only. The STANDING signal set for this vintage -- what is flagged RIGHT NOW, which is the series a dashboard charts. `diff` answers a different question (what MOVED) under `signal_movement`; a repo quietly bad for a year shows no movement at all. The DENOMINATOR ships with the numerator: `flagged` is meaningless without `measured`, and `unmeasured` is published beside both because a node whose vintage carried no signals block is UNKNOWN, not clean. The terminal surface caps its list; this one carries the full set, because a consumer that asked for JSON asked for the data.",
      "type": "object",
      "required": ["measured", "unmeasured", "flagged", "counts", "nodes"],
      "additionalProperties": false,
      "properties": {
        "measured": { "type": "integer", "minimum": 0 },
        "unmeasured": { "type": "integer", "minimum": 0 },
        "flagged": { "type": "integer", "minimum": 0 },
        "counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "symbol", "signal"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "symbol": { "type": "string" },
              "signal": { "type": "string" },
              "strength": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "signal_movement": {
      "description": "OPTIONAL, diff-only. Signal MOVEMENT between the two vintages -- what flipped and what shifted materially, NOT the standing set. ABSENT when nothing moved: an empty block and 'no movement' are the same fact, and emitting an empty array every run would train a consumer to ignore the key. Carries NO severity and NO exit-code field BY CONSTRUCTION -- the ratchet gates on score, this reports movement.",
      "type": "object",
      "required": ["summary", "movements"],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "movements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "symbol", "signal", "direction"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "symbol": { "type": "string" },
              "signal": { "type": "string" },
              "direction": { "enum": ["fired", "cleared", "strength"] },
              "base_strength": { "type": ["number", "null"] },
              "head_strength": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "reusability": {
      "type": "object",
      "required": ["base", "head", "deltas", "absorb_candidates"],
      "additionalProperties": false,
      "properties": {
        "base": { "$ref": "#/definitions/score_side_provenance" },
        "head": { "$ref": "#/definitions/score_side_provenance" },
        "deltas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "symbol", "classification", "base", "head", "delta_raw_milli"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "symbol": { "type": "string" },
              "classification": { "enum": ["NEW", "GROWN", "SHRUNK"] },
              "base": { "$ref": "#/definitions/score_stamp" },
              "head": { "$ref": "#/definitions/score_stamp" },
              "delta_raw_milli": { "type": ["integer", "null"] }
            }
          }
        },
        "absorb_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "symbol", "score", "absorb", "absorb_raw"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "symbol": { "type": "string" },
              "score": { "type": "number" },
              "absorb": { "type": "number" },
              "absorb_raw": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "ratchet_context": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope_paths", "kind", "budget_log2", "current_total_log2", "matched_files"]
      }
    },
    "grandfathered": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "file", "symbol", "recorded", "current", "healed"]
      }
    },
    "calibration": {
      "type": "object",
      "required": ["source", "provenance", "lines"],
      "properties": {
        "source": { "enum": ["builtin-study-v1", "local", "none"] },
        "provenance": { "type": ["string", "null"] },
        "lines": { "type": "array", "items": { "type": "string" } }
      }
    },
    "exit_code": { "enum": [0, 1, 2] }
  },
  "definitions": {
    "score_side_provenance": {
      "type": "object",
      "required": ["source", "analyzed", "serializer", "scored_nodes", "stale_stamps"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "analyzed": { "type": "boolean" },
        "serializer": { "type": "array", "items": { "type": "integer" } },
        "scored_nodes": { "type": "integer" },
        "stale_stamps": { "type": "integer" }
      }
    },
    "score_stamp": {
      "type": ["object", "null"],
      "required": ["score", "score_raw"],
      "additionalProperties": false,
      "properties": {
        "score": { "type": "number" },
        "score_raw": { "type": "number" }
      }
    }
  }
}
